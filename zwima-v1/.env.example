# Database
DATABASE_URL="postgresql://user:password@localhost:5432/zwima_v1"

# Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
# When FAPI custom host (e.g. clerk.yourdomain.com) has no DNS, proxy via app:
# NEXT_PUBLIC_CLERK_PROXY_URL=https://zwima-group.info/__clerk
CLERK_WEBHOOK_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CREDIT_PRICE_ID=
# Preview only — set true to block all Stripe checkout/webhook/subscription calls
STRIPE_PREVIEW_DISABLED=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@zwima-group.info

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Billing
CREDITS_MARGIN=1.3
ADMIN_EMAILS=admin@zwima-group.info

# Internal / cron (service role). Prefer a dedicated secret; do not reuse Clerk or Stripe keys.
# Used by /api/internal/** endpoints (model lifecycle, compliance automation, regulatory scan).
INTERNAL_SERVICE_ROLE_KEY=
SERVICE_ROLE_API_KEY=

# AI Providers (read from .env.local)
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
ANTHROPIC_API_KEY=
