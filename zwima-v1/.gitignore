# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/playwright/.auth/
/artifacts/
*-rc-out.txt
*-report.txt
test-report.txt
prisma-gen-report.txt
typecheck-report.txt
build-out.txt
lint-out.txt
vitest-out.txt
migrate-diff-err.txt
git-status-out.txt

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.key
*.p12
*.pfx
.tmp_*
.tmp_pull_*.env

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (never commit real env)
.env
.env.*
!.env.example

# dumps / backups / credential material
*.dump
*.sql.backup
*.bak
credentials.json
**/credentials.json
**/service-account*.json
**/backups/
**/backup/
ZWIMA_SECURE_BACKUPS/
**/ZWIMA_SECURE_BACKUPS/
local-db-exports/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*
!.env.example
