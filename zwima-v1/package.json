{
  "name": "zwima-v1",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "vercel-build": "node scripts/vercel-build.mjs",
    "start": "next start",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "npx vitest run",
    "test:watch": "vitest",
    "ci:safety": "node scripts/ci/gap013-ci-safety-gate.mjs",
    "ci:secret-scan": "node scripts/ci/gap013-secret-scan.mjs",
    "ci:prisma-validate": "node scripts/ci/gap013-prisma-validate.mjs",
    "backup:check": "npx tsx scripts/backup/gap014-backup-capability-check.ts",
    "recovery:drill": "npx tsx scripts/recovery/gap014-recovery-drill.ts",
    "ci": "npm run ci:safety && npm run ci:secret-scan && npm run ci:prisma-validate && npm run backup:check && npm run recovery:drill && npm run lint && npm run typecheck && npm test",
    "e2e:auth": "node scripts/e2e-auth.mjs",
    "e2e:auth:setup": "playwright test --project=setup --headed",
    "e2e:phase4": "node scripts/e2e-phase4.mjs",
    "e2e:phase4:headed": "node scripts/e2e-phase4.mjs --headed",
    "db:generate": "prisma generate",
    "db:push": "node scripts/db-push-authorized.mjs",
    "db:migrate:authorized": "node scripts/db-migrate-authorized.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.5.17",
    "@prisma/client": "^6.19.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "next": "15.5.20",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "resend": "^6.17.2",
    "stripe": "^22.3.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.20",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
