  modelId          String
  inputTokenCost   Decimal  @db.Decimal(12, 6)
  outputTokenCost  Decimal  @db.Decimal(12, 6)
  marginPercent    Decimal  @default(30) @db.Decimal(6, 2)
  customerPriceIn  Decimal  @db.Decimal(12, 6)
  customerPriceOut Decimal  @db.Decimal(12, 6)
  updatedAt        DateTime @updatedAt

  @@unique([providerSlug, modelId])
  @@index([providerSlug])
}

// ─── V1.1 Unified Cost Engine (additive on M3/M4) ─────────────────────────────

model PriceVersion {
  id            String             @id @default(cuid())
  version       String             @unique
  label         String?
  status        PriceVersionStatus @default(ACTIVE)
  effectiveFrom DateTime           @default(now())
  effectiveTo   DateTime?
  notes         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  profiles CostProfile[]
  history  PriceHistory[]

  @@index([status, effectiveFrom])
}

model CostProfile {
  id                 String    @id @default(cuid())
  provider           String
  model              String
  modelVersion       String    @default("")
  inputPricePer1M    Decimal   @db.Decimal(14, 6)
  outputPricePer1M   Decimal   @db.Decimal(14, 6)
  cacheReadPrice     Decimal?  @db.Decimal(14, 6)
  cacheWritePrice    Decimal?  @db.Decimal(14, 6)
  toolCallPrice      Decimal?  @db.Decimal(14, 6)
  retryPrice         Decimal?  @db.Decimal(14, 6)
  regionSurcharge    Decimal?  @db.Decimal(8, 4)
  currency           String    @default("EUR")
  priceVersionId     String
  effectiveFrom      DateTime  @default(now())
  effectiveTo        DateTime?
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  priceVersion PriceVersion @relation(fields: [priceVersionId], references: [id], onDelete: Restrict)
  history      PriceHistory[]
  calculations CostCalculation[]

  @@unique([provider, model, modelVersion, priceVersionId])
  @@index([provider, model, active, effectiveFrom])
  @@index([priceVersionId])
}

model PriceHistory {
  id             String   @id @default(cuid())
  costProfileId  String?
  provider       String
  model          String
  modelVersion   String?
  field          String
  oldValue       Decimal? @db.Decimal(14, 6)
  newValue       Decimal? @db.Decimal(14, 6)
  priceVersionId String
  changedAt      DateTime @default(now())
  changedBy      String?
  reason         String?

  costProfile  CostProfile? @relation(fields: [costProfileId], references: [id], onDelete: SetNull)
  priceVersion PriceVersion @relation(fields: [priceVersionId], references: [id], onDelete: Restrict)

  @@index([provider, model, changedAt])
  @@index([priceVersionId, changedAt])
  @@index([costProfileId])
}

model CostCalculation {
  id             String   @id @default(cuid())
  provider       String
  model          String
  modelVersion   String   @default("")
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  cacheReadTokens Int     @default(0)
  cacheWriteTokens Int    @default(0)
  toolCalls      Int      @default(0)
  retries        Int      @default(0)
  region         String?
  estimatedCost  Decimal  @db.Decimal(14, 6)
  actualCost     Decimal  @db.Decimal(14, 6)
  grossMargin    Decimal  @db.Decimal(14, 6)
  netMargin      Decimal  @db.Decimal(14, 6)
  marginPercent  Decimal  @db.Decimal(8, 4)
  currency       String   @default("EUR")
  /// M4 FX snapshot fields (immutable once written with usage)
  providerCurrency        String?
  fxRateAtUsage           Decimal?  @db.Decimal(18, 10)
  costInProviderCurrency  Decimal?  @db.Decimal(18, 8)
  costInEur               Decimal?  @db.Decimal(18, 8)
  fxBufferRate            Decimal?  @db.Decimal(8, 6)
  fxBuffer                Decimal?  @db.Decimal(18, 8)
  bufferedCostEur         Decimal?  @db.Decimal(18, 8)
  revenueEur              Decimal?  @db.Decimal(18, 8)
  grossMarginEur          Decimal?  @db.Decimal(18, 8)
  grossMarginRate         Decimal?  @db.Decimal(12, 8)
  fxRateSource            String?
  fxRateTimestamp         DateTime?
  fxRateDate              DateTime?
  fxRatePair              String?
  fxRateStatus            FxRateStatus?
  fxRateSnapshotId        String?
  /// Analysis-only revaluation (must never overwrite costInEur)
  revaluedCostInEur       Decimal?  @db.Decimal(18, 8)
  revaluedAt              DateTime?
  priceVersionId String?
  costProfileId  String?
  usageLogId     String?
  customerCredits Int?
  breakdown      Json?
  createdAt      DateTime @default(now())

  costProfile CostProfile? @relation(fields: [costProfileId], references: [id], onDelete: SetNull)
  fxRateSnapshot FxRateSnapshot? @relation(fields: [fxRateSnapshotId], references: [id], onDelete: SetNull)

  @@index([provider, model, createdAt])
  @@index([usageLogId])
  @@index([costProfileId])
  @@index([fxRateSnapshotId])
  @@index([fxRateStatus])
}

// ─── Routing ─────────────────────────────────────────────────────────────────

model RoutingPolicy {
  id                    String          @id @default(cuid())
  organizationId        String?
  name                  String
  strategy              RoutingStrategy @default(BALANCED)
