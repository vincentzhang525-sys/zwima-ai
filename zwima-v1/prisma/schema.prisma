  subWorkflowId   String?
  memoryRefId     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  version WorkflowVersion @relation(fields: [versionId], references: [versionId], onDelete: Cascade)
  outEdges WorkflowEdge[] @relation("EdgeFrom")
  inEdges  WorkflowEdge[] @relation("EdgeTo")
  steps    WorkflowStepExecution[]

  @@unique([versionId, key])
  @@index([versionId, type])
  @@index([agentId])
}

model WorkflowEdge {
  id           String   @id @default(cuid())
  edgeId       String   @unique
  versionId    String
  fromNodeId   String
  toNodeId     String
  conditionKey String?
  label        String?
  createdAt    DateTime @default(now())

  version  WorkflowVersion @relation(fields: [versionId], references: [versionId], onDelete: Cascade)
  fromNode WorkflowNode    @relation("EdgeFrom", fields: [fromNodeId], references: [nodeId], onDelete: Cascade)
  toNode   WorkflowNode    @relation("EdgeTo", fields: [toNodeId], references: [nodeId], onDelete: Cascade)

  @@unique([versionId, fromNodeId, toNodeId, conditionKey])
  @@index([versionId])
}

model WorkflowTrigger {
  id             String              @id @default(cuid())
  triggerId      String              @unique
  workflowId     String
  organizationId String
  type           WorkflowTriggerType
  enabled        Boolean             @default(true)
  config         Json                @default("{}")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  workflow WorkflowDefinition     @relation(fields: [workflowId], references: [workflowId], onDelete: Cascade)
  schedule WorkflowSchedule?
  webhook  WorkflowWebhookConfig?

  @@index([organizationId, type, enabled])
  @@index([workflowId])
}

model WorkflowVariable {
  id          String   @id @default(cuid())
  variableId  String   @unique
  versionId   String
  key         String
  valueType   String   @default("string")
  defaultValue Json?
  required    Boolean  @default(false)
  createdAt   DateTime @default(now())

  version WorkflowVersion @relation(fields: [versionId], references: [versionId], onDelete: Cascade)

  @@unique([versionId, key])
  @@index([versionId])
}

model WorkflowSecretReference {
  id             String   @id @default(cuid())
  secretRefId    String   @unique
  workflowId     String
  organizationId String
  key            String
  providerHint   String?
  createdAt      DateTime @default(now())

  workflow WorkflowDefinition @relation(fields: [workflowId], references: [workflowId], onDelete: Cascade)

  @@unique([workflowId, key])
  @@index([organizationId])
}

model WorkflowPolicy {
  id             String   @id @default(cuid())
  policyId       String   @unique
  organizationId String
  key            String
  value          Json
  version        Int      @default(1)
  updatedBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, key])
  @@index([organizationId])
}

model WorkflowSchedule {
  id           String   @id @default(cuid())
  scheduleId   String   @unique
  triggerId    String   @unique
  cronExpr     String
  timezone     String   @default("UTC")
  nextRunAt    DateTime?
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  trigger WorkflowTrigger @relation(fields: [triggerId], references: [triggerId], onDelete: Cascade)
}

model WorkflowWebhookConfig {
  id              String   @id @default(cuid())
  webhookConfigId String   @unique
  triggerId       String   @unique
  pathSuffix      String
  secretRefKey    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  trigger WorkflowTrigger @relation(fields: [triggerId], references: [triggerId], onDelete: Cascade)

  @@index([pathSuffix])
}

model WorkflowRetryPolicy {
  id            String  @id @default(cuid())
  policyId      String  @unique
  versionId     String  @unique
  maxRetries    Int     @default(1)
  backoffMs     Int     @default(1000)
  retryOn       String[] @default(["FAILED", "TIMED_OUT"])

  version WorkflowVersion @relation(fields: [versionId], references: [versionId], onDelete: Cascade)
}

model WorkflowErrorPolicy {
  id                 String  @id @default(cuid())
  policyId           String  @unique
  versionId          String  @unique
  onFailure          String  @default("STOP")
  failureBranchKey   String?
  compensationMeta   Json    @default("{}")

  version WorkflowVersion @relation(fields: [versionId], references: [versionId], onDelete: Cascade)
}

model WorkflowExecution {
  id                      String                  @id @default(cuid())
  executionId             String                  @unique
  workflowId              String
  workflowVersionId       String
  organizationId          String
  workspaceId             String?
  userId                  String?
  triggerType             WorkflowTriggerType     @default(MANUAL)
  status                  WorkflowExecutionStatus @default(QUEUED)
  input                   Json                    @default("{}")
  output                  Json?
  idempotencyKey          String?
  concurrencyKey          String?
  estimatedCost           Float?
  actualCost              Float?
  grossMargin             Float?
  priceVersionId          String?
  costProfileId           String?
  costCalculationId       String?
  tokenUsage              Json                    @default("{\"inputTokens\":0,\"outputTokens\":0}")
  retryCost               Float?
  toolCost                Float?
  requestedModel          String?
  resolvedModel           String?
  registryEntryId         String?
  migrationReason         String?
  replacementModel        String?
  lifecycleStatus         String?
  eventId                 String?
  complianceAuditRecordId String?
  processingRegion        String?
  policyVersion           String?
  forceReview             Boolean                 @default(false)
  errorMessage            String?
  errorClass              String?
  retryOfExecutionId      String?
  startedAt               DateTime?
  completedAt             DateTime?
  pausedAt                DateTime?
  currentNodeId           String?
  retryCount              Int                     @default(0)
  maxRetries              Int                     @default(3)
  resumedAt               DateTime?
  cancelledAt             DateTime?
  rollbackAvailable       Boolean                 @default(false)
  rollbackStatus          String?
  agentRunId              String?
  complianceEventId       String?
  effectiveCostAmount     Decimal?                @db.Decimal(14, 6)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workflow     WorkflowDefinition      @relation(fields: [workflowId], references: [workflowId], onDelete: Restrict)
  version      WorkflowVersion         @relation(fields: [workflowVersionId], references: [versionId], onDelete: Restrict)
  steps        WorkflowStepExecution[]
  logs         WorkflowExecutionLog[]
  approvals    WorkflowApproval[]
  histories    WorkflowExecutionHistory[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, workflowId, createdAt])
  @@index([workflowVersionId])
  @@index([eventId])
  @@index([concurrencyKey, status])
}

model WorkflowStepExecution {
  id                 String            @id @default(cuid())
  stepExecutionId    String            @unique
  executionId        String
  nodeId             String
  sequence           Int
  status             WorkflowStepStatus @default(PENDING)
  input              Json?
  output             Json?
  agentRunId         String?
  estimatedCost      Float?
  actualCost         Float?
  grossMargin        Float?
  priceVersionId     String?
  costProfileId      String?
  costCalculationId  String?
  tokenUsage         Json              @default("{\"inputTokens\":0,\"outputTokens\":0}")
  retryCost          Float?
  toolCost           Float?
  requestedModel     String?
  resolvedModel      String?
  registryEntryId    String?
  migrationReason    String?
  replacementModel   String?
  lifecycleStatus    String?
  errorMessage       String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  execution WorkflowExecution @relation(fields: [executionId], references: [executionId], onDelete: Cascade)
  node      WorkflowNode      @relation(fields: [nodeId], references: [nodeId], onDelete: Restrict)
  approvals WorkflowApproval[]

  @@unique([executionId, sequence])
  @@index([executionId, status])
  @@index([agentRunId])
  @@index([nodeId])
}

model WorkflowExecutionLog {
  id        String   @id @default(cuid())
  logId     String   @unique
  executionId String
  level     String   @default("info")
  message   String
  payload   Json?
  createdAt DateTime @default(now())

  execution WorkflowExecution @relation(fields: [executionId], references: [executionId], onDelete: Cascade)

  @@index([executionId, createdAt])
}

model WorkflowApproval {
  id             String                 @id @default(cuid())
  approvalId     String                 @unique
  executionId    String
  stepExecutionId String?
  organizationId String
  reviewCaseId   String?
  eventId        String?
  agentReviewLinkId String?
  status         WorkflowApprovalStatus @default(PENDING)
  decidedBy      String?
  decisionNote   String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  execution     WorkflowExecution      @relation(fields: [executionId], references: [executionId], onDelete: Cascade)
  stepExecution WorkflowStepExecution? @relation(fields: [stepExecutionId], references: [stepExecutionId], onDelete: SetNull)

  @@index([organizationId, status, createdAt])
  @@index([executionId])
  @@index([reviewCaseId])
}

// ─── M10 Enterprise Dashboard (additive, read-aggregation support) ───────────

enum DashboardExportFormat {
