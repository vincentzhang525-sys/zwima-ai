generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users & Organizations ───────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  clerkId       String   @unique
  email         String   @unique
  companyName   String?
  country       String?
  vatId         String?
  tier          UserTier @default(STANDARD)
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  apiKeys              ApiKey[]
  creditBalance        CreditBalance?
  transactions         Transaction[]
  payments             Payment[]
  usageLogs            UsageLog[]
  invoices             Invoice[]
  subscriptions        Subscription[]
  referral             Referral?
  notifications        Notification[]
  auditLogs            AuditLog[]
  ownedOrganizations   Organization[]       @relation("OrgOwner")
  organizationMembers  OrganizationMember[]
  aiAuditLogs          AiAuditLog[]
  revokedApiKeys       ApiKey[]             @relation("ApiKeyRevokedBy")
  complianceRoles      ComplianceRoleAssignment[]
  dashboardSavedViews  DashboardSavedView[]
  dashboardExports     DashboardExport[] @relation("DashboardExportRequester")
  dashboardWidgetPreferences DashboardWidgetPreference[]
  dashboardAlertPreferences  DashboardAlertPreference[]
}

model Organization {
  id                    String   @id @default(cuid())
  name                  String
  ownerId               String
  defaultRoutingPolicyId String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  owner           User              @relation("OrgOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members         OrganizationMember[]
  apiKeys         ApiKey[]
  routingPolicies RoutingPolicy[]
  aiAuditLogs     AiAuditLog[]
  securityEvents  SecurityEvent[]
  complianceRoles ComplianceRoleAssignment[]
  aiSystems       AISystem[]
  complianceEvidence ComplianceEvidence[]
  complianceDocuments ComplianceDocument[]
  complianceAuditSessions ComplianceAuditSession[]
  complianceRules ComplianceRule[]
  complianceEvents ComplianceEvent[]
  complianceTasks ComplianceTask[]
  complianceAutomationRuns ComplianceAutomationRun[]
  complianceScoreSnapshots ComplianceScoreSnapshot[]
  regulatorySources        RegulatorySource[]
  regulatoryChanges        RegulatoryChange[]
  enterpriseOrgProfile     EnterpriseOrgProfile?
  enterpriseWorkspaces     EnterpriseWorkspace[]
  enterpriseDepartments    EnterpriseDepartment[]
  enterpriseTeams          EnterpriseTeam[]
  enterpriseInvitations    EnterpriseInvitation[]
  enterpriseRoles          EnterpriseRole[]
  enterpriseMemberRoles    EnterpriseMemberRole[]
  enterpriseApiAccesses    EnterpriseApiAccess[]
  enterpriseCostCenters    EnterpriseCostCenter[]
  enterpriseBillingAccount EnterpriseBillingAccount?
  enterpriseActivityLogs   EnterpriseActivityLog[]
  enterpriseAuditEvents    EnterpriseAuditEvent[]
  agentDefinitions         AgentDefinition[]
  agentRuns                AgentRun[]
  toolDefinitions          ToolDefinition[]
  promptTemplates          PromptTemplate[]
  agentMemories            AgentMemory[]
  agentOrgPolicies         AgentOrgPolicy[]
  agentTemplates           AgentTemplate[]
  agentMemoryPolicies      AgentMemoryPolicy[]
  workflowDefinitions      WorkflowDefinition[]
  workflowExecutions       WorkflowExecution[]
  workflowPolicies         WorkflowPolicy[]
  dashboardSnapshots       DashboardSnapshot[]
  dashboardSavedViews      DashboardSavedView[]
  dashboardExports         DashboardExport[]
  dashboardWidgetPreferences DashboardWidgetPreference[]
  dashboardAlertPreferences  DashboardAlertPreference[]
  taskCostProfiles         TaskCostProfile[]
  modelEffectiveCostSnapshots ModelEffectiveCostSnapshot[]
  agentToolExecutions      AgentToolExecution[]
  agentResourceAccesses    AgentResourceAccess[]
  agentToolBindings        AgentToolBinding[]
  agentExecutionLogs       AgentExecutionLog[]
  workflowExecutionHistories WorkflowExecutionHistory[]
  enterpriseAiModelScores  EnterpriseAIModelScore[]
  backgroundJobs           BackgroundJob[]
  rateLimitPolicies        RateLimitPolicy[]
  serviceLevelObjectives   ServiceLevelObjective[]
  providerSecretReferences ProviderSecretReference[]

  @@index([ownerId])
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           OrgRole  @default(DEVELOPER)
  invitedEmail   String?
  accepted       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

// ─── API Keys ────────────────────────────────────────────────────────────────

model ApiKey {
  id                 String        @id @default(cuid())
  userId             String
  organizationId     String?
  name               String
  keyHash            String
  prefix             String
  enabled            Boolean       @default(true)
  status             ApiKeyStatus  @default(ACTIVE)
  permission         KeyPermission @default(FULL)
  permissions        String[]      @default([])
  ipWhitelist        String?
  usageLimit         Int?
  usageCount         Int           @default(0)
  rpmLimit           Int?
  tpmLimit           Int?
  dailyBudget        Int?
  monthlyBudget      Int?
  currentMonthUsage  Int           @default(0)
  currentMonthStart  DateTime?
  allowedProviders   String[]      @default([])
  allowedModels      String[]      @default([])
  environment        String        @default("production")
  metadata           Json?
  expiresAt          DateTime?
  revokedAt          DateTime?
  revokedById        String?
  revokeReason       String?
  createdAt          DateTime      @default(now())
  lastUsed           DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  revokedBy    User?         @relation("ApiKeyRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)
  usageLogs    UsageLog[]
  aiAuditLogs  AiAuditLog[]
  securityEvents SecurityEvent[]

  @@index([userId])
  @@index([keyHash])
  @@index([organizationId])
  @@index([status])
}

// ─── Provider Infrastructure ─────────────────────────────────────────────────

model Provider {
  id                String         @id @default(cuid())
  slug              String         @unique
  name              String
  enabled           Boolean        @default(true)
  status            ProviderStatus @default(ACTIVE)
  /// Supplier list price currency (USD, EUR, GBP, CNY, …)
  providerCurrency  String         @default("USD")
  baseUrl           String?
  region            String?
  dataResidency     String?
  supportsStreaming Boolean        @default(false)
  supportsTools     Boolean        @default(false)
  supportsVision    Boolean        @default(false)
  weight            Int            @default(100)
  priority          Int            @default(0)
  config            Json?
  lastError         String?
  lastLatency       Int?
  lastHealthAt      DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  models      ProviderModel[]
  health      ProviderHealth?
  usageLogs   UsageLog[]
  aiAuditLogs AiAuditLog[]
  availabilityStatuses ModelAvailabilityStatus[]
  healthObservations ModelHealthObservation[]
  healthIncidents ModelHealthIncident[]
  healthAggregates ModelHealthAggregate[]
  healthSlaPolicies ModelHealthSlaPolicy[]
  discoverySources ModelDiscoverySource[]
  syncProfiles     ProviderSyncProfile[]
  syncJobs         ProviderSyncJob[]
  syncConflicts    ProviderSyncConflict[]
  pricingSignals   ProviderPricingChangeSignal[]
  fxBufferPolicies FxBufferPolicy[]
}

model ProviderModel {
  id                  String              @id @default(cuid())
  providerId          String
  modelCode           String
  displayName         String
  modelFamily         String?
  modelType           ModelType           @default(CHAT)
  contextWindow       Int?
  maxOutputTokens     Int?
  qualityTier         QualityTier         @default(STANDARD)
  speedTier           SpeedTier           @default(BALANCED)
  status              ProviderModelStatus @default(DRAFT)
  replacementModelId  String?
  deprecationDate     DateTime?
  releaseDate         DateTime?
  region              String?
  euAvailable         Boolean             @default(true)
  supportsStreaming   Boolean             @default(false)
  supportsTools       Boolean             @default(false)
  supportsVision      Boolean             @default(false)
  supportsJson        Boolean             @default(false)
  supportsReasoning   Boolean             @default(false)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  provider          Provider               @relation(fields: [providerId], references: [id], onDelete: Cascade)
  replacementModel  ProviderModel?         @relation("ModelReplacement", fields: [replacementModelId], references: [id], onDelete: SetNull)
  replacedBy        ProviderModel[]        @relation("ModelReplacement")
  pricing           ModelPricingRecord[]
  compliance        ModelComplianceProfile?
  aiAuditLogs       AiAuditLog[]

  @@unique([providerId, modelCode])
  @@index([modelCode])
  @@index([status])
  @@index([replacementModelId])
}

model ModelComplianceProfile {
  id                         String            @id @default(cuid())
  providerModelId            String            @unique
  transparencyRequired       Boolean           @default(false)
  aiGeneratedLabelRequired     Boolean           @default(true)
  deepfakeDisclosureRequired   Boolean           @default(false)
  complianceStatus           ComplianceStatus  @default(PENDING_REVIEW)
  notes                      String?
  reviewedAt                 DateTime?
  reviewedBy                 String?
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt

  providerModel ProviderModel @relation(fields: [providerModelId], references: [id], onDelete: Cascade)

  @@index([complianceStatus])
}

model ModelPricingRecord {
  id                               String        @id @default(cuid())
  providerModelId                  String
  currency                         Currency      @default(EUR)
  inputPricePerMillionTokens       Decimal       @db.Decimal(14, 6)
  cachedInputPricePerMillionTokens Decimal?      @db.Decimal(14, 6)
  cacheWritePricePerMillionTokens  Decimal?      @db.Decimal(14, 6)
  outputPricePerMillionTokens      Decimal       @db.Decimal(14, 6)
  longContextPricePerMillionTokens Decimal?      @db.Decimal(14, 6)
  requestPrice                     Decimal?      @db.Decimal(14, 6)
  imagePrice                       Decimal?      @db.Decimal(14, 6)
  audioPrice                       Decimal?      @db.Decimal(14, 6)
  searchToolPricePerRequest        Decimal?      @db.Decimal(14, 6)
  batchDiscount                    Decimal?      @db.Decimal(6, 4)
  retryCostMultiplier              Decimal?      @default(1) @db.Decimal(6, 4)
  providerDiscount                 Decimal?      @db.Decimal(6, 4)
  internalCostMultiplier           Decimal       @default(1) @db.Decimal(6, 4)
  platformMarkupPercent            Decimal       @default(30) @db.Decimal(6, 2)
  minimumCharge                    Decimal?      @db.Decimal(10, 4)
  effectiveFrom                    DateTime      @default(now())
  effectiveUntil                   DateTime?
  promotionName                    String?
  promotionActive                  Boolean       @default(false)
  promotionEndDate                 DateTime?
  pricingStatus                    PricingStatus @default(DRAFT)
  sourceUrl                        String?
  verifiedAt                       DateTime?
  verifiedBy                       String?
  notes                            String?
  createdAt                        DateTime      @default(now())
  updatedAt                        DateTime      @updatedAt

  providerModel ProviderModel @relation(fields: [providerModelId], references: [id], onDelete: Cascade)

  @@index([providerModelId, effectiveFrom])
  @@index([pricingStatus, effectiveFrom, effectiveUntil])
}

model ProviderHealth {
  id                  String         @id @default(cuid())
  providerId          String         @unique
  status              HealthStatus   @default(UNKNOWN)
  latencyP50          Int?
  latencyP95          Int?
  successRate         Decimal?       @db.Decimal(5, 4)
  errorRate           Decimal?       @db.Decimal(5, 4)
  lastSuccessAt       DateTime?
  lastFailureAt       DateTime?
  lastErrorCode       String?
  consecutiveFailures Int            @default(0)
  updatedAt           DateTime       @updatedAt

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

// ─── M5.1 Model Registry ─────────────────────────────────────────────────────

model ModelRegistryEntry {
  id                 String                  @id @default(cuid())
  registryKey        String                  @unique
  providerSlug       String
  modelCode          String
  displayName        String
  description        String?
  modelType          ModelType               @default(CHAT)
  status             ModelRegistryStatus     @default(DRAFT)
  visibility         ModelRegistryVisibility @default(PUBLIC)
  contextWindow      Int?
  maxOutputTokens    Int?
  qualityTier        QualityTier             @default(STANDARD)
  speedTier          SpeedTier               @default(BALANCED)
  region             String?
  euAvailable        Boolean                 @default(true)
  supportedRegions   String[]                @default([])
  capabilities       String[]                @default([])
  tags               String[]                @default([])
  supportsStreaming  Boolean                 @default(false)
  supportsTools      Boolean                 @default(false)
  supportsVision     Boolean                 @default(false)
  supportsImage      Boolean                 @default(false)
  supportsAudio      Boolean                 @default(false)
  supportsJson       Boolean                 @default(false)
  supportsFunctionCalling Boolean            @default(false)
  supportsStructuredOutput Boolean           @default(false)
  supportsReasoning  Boolean                 @default(false)
  documentationUrl   String?
  pricingVersion     String?
  tokenizerVersion   String?
  promotionStartDate DateTime?
  promotionEndDate   DateTime?
  migrationDeadline  DateTime?
  compatibilityStatus String?
  migrationGuidanceUrl String?
  lastLifecycleCheckAt DateTime?
  lifecycleSource    String?
  releaseDate        DateTime?
  deprecationDate    DateTime?
  shutdownDate       DateTime?
  autoMigration      Boolean                 @default(false)
  publishedAt        DateTime?
  deprecatedAt       DateTime?
  replacementEntryId String?
  sortOrder          Int                     @default(0)
  metadata           Json?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  replacementEntry ModelRegistryEntry?  @relation("RegistryReplacement", fields: [replacementEntryId], references: [id], onDelete: SetNull)
  replacedBy       ModelRegistryEntry[] @relation("RegistryReplacement")
  changeLogs       ModelRegistryChangeLog[]
  versions         ModelVersion[]
  capabilityAssignments ModelCapabilityAssignment[]
  deprecationPolicies ModelDeprecationPolicy[] @relation("DeprecationTargetModel")
  replacementForDeprecationPolicies ModelDeprecationPolicy[] @relation("DeprecationReplacementModel")
  availabilityStatuses ModelAvailabilityStatus[]
  availabilityOverrides ModelAvailabilityOverride[]
  healthObservations ModelHealthObservation[]
  healthIncidents ModelHealthIncident[]
  healthAggregates ModelHealthAggregate[]
  healthSlaPolicies ModelHealthSlaPolicy[]
  discoveryMappings ModelDiscoveryMapping[]
  migrationsFrom ModelMigrationPolicy[] @relation("MigrationFrom")
  migrationsTo   ModelMigrationPolicy[] @relation("MigrationTo")

  @@unique([providerSlug, modelCode])
  @@index([status, visibility])
  @@index([providerSlug])
  @@index([replacementEntryId])
  @@index([autoMigration])
}

/// DB-driven auto migration: offline models rewrite to replacement without code changes.
model ModelMigrationPolicy {
  id                   String    @id @default(cuid())
  fromRegistryId       String
  toRegistryId         String
  fromVersionId        String?
  toVersionId          String?
  triggerType          String?
  autoMigrate          Boolean   @default(true)
  notifyBeforeMigration Boolean  @default(false)
  requireHumanApproval Boolean   @default(false)
  compatibilityMode    String?
  fallbackRegistryId   String?
  status               String    @default("ACTIVE")
  enabled              Boolean   @default(true)
  reason               String?
  effectiveFrom        DateTime  @default(now())
  effectiveTo          DateTime?
  createdBy            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  fromRegistry ModelRegistryEntry @relation("MigrationFrom", fields: [fromRegistryId], references: [id], onDelete: Cascade)
  toRegistry   ModelRegistryEntry @relation("MigrationTo", fields: [toRegistryId], references: [id], onDelete: Cascade)

  @@index([fromRegistryId, enabled, autoMigrate])
  @@index([toRegistryId])
  @@index([effectiveFrom, effectiveTo])
}

model ModelRegistryChangeLog {
  id          String   @id @default(cuid())
  entryId     String
  action      String
  actorUserId String?
  before      Json?
  after       Json?
  createdAt   DateTime @default(now())

  entry ModelRegistryEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId, createdAt])
}

// ─── M5.2 Model Version Management ───────────────────────────────────────────

model ModelVersion {
  id                 String                  @id @default(cuid())
  modelRegistryId    String
  providerVersionId  String
  versionLabel       String
  displayName        String
  releaseDate        DateTime?
  releaseChannel     ReleaseChannel          @default(STABLE)
  lifecycleStatus    VersionLifecycleStatus  @default(ACTIVE)
  isDefault          Boolean                 @default(false)
  contextWindow      Int?
  maxOutputTokens    Int?
  inputPrice         Decimal                 @default(0) @db.Decimal(14, 6)
  outputPrice        Decimal                 @default(0) @db.Decimal(14, 6)
  capabilitySnapshot Json?
  metadata           Json?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  registry ModelRegistryEntry      @relation(fields: [modelRegistryId], references: [id], onDelete: Cascade)
  history  ModelVersionHistory[]
  capabilityAssignments ModelVersionCapabilityAssignment[]
  deprecationPolicies ModelDeprecationPolicy[] @relation("DeprecationTargetVersion")
  replacementForDeprecationPolicies ModelDeprecationPolicy[] @relation("DeprecationReplacementVersion")
  availabilityStatuses ModelAvailabilityStatus[]
  availabilityOverrides ModelAvailabilityOverride[]
  healthObservations ModelHealthObservation[]
  healthIncidents ModelHealthIncident[]
  healthAggregates ModelHealthAggregate[]
  healthSlaPolicies ModelHealthSlaPolicy[]
  releaseAssignments ModelVersionReleaseAssignment[]
  releasePromotions ModelReleasePromotion[]
  releaseAccessPolicies ModelReleaseAccessPolicy[]
  discoveryMappings ModelDiscoveryMapping[]

  @@unique([modelRegistryId, providerVersionId])
  @@index([modelRegistryId, isDefault])
  @@index([modelRegistryId, lifecycleStatus])
  @@index([releaseChannel])
}

model ModelVersionHistory {
  id            String   @id @default(cuid())
  versionId     String
  action        String
  previousState Json?
  newState      Json?
  changedBy     String?
  reason        String?
  createdAt     DateTime @default(now())

  version ModelVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId, createdAt])
}

// ─── M5.3 Model Capability Management ────────────────────────────────────────

enum CapabilityDataType {
  BOOLEAN
  NUMBER
  STRING
  ENUM
  JSON
}

model ModelCapabilityDefinition {
  id            String             @id @default(cuid())
  capabilityKey String             @unique
  displayName   String
  description   String?
  category      String
  dataType      CapabilityDataType   @default(BOOLEAN)
  unit          String?
  isSystem      Boolean            @default(false)
  isActive      Boolean            @default(true)
  metadata      Json?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  modelAssignments   ModelCapabilityAssignment[]
  versionAssignments ModelVersionCapabilityAssignment[]

  @@index([category, isActive])
  @@index([isActive])
}

model ModelCapabilityAssignment {
  id                     String   @id @default(cuid())
  modelRegistryId        String
  capabilityDefinitionId String
  supported              Boolean  @default(false)
  value                  Json?
  source                 String?
  confidence             Decimal? @db.Decimal(5, 4)
  verifiedAt             DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  registry   ModelRegistryEntry        @relation(fields: [modelRegistryId], references: [id], onDelete: Cascade)
  definition ModelCapabilityDefinition @relation(fields: [capabilityDefinitionId], references: [id], onDelete: Restrict)

  @@unique([modelRegistryId, capabilityDefinitionId])
  @@index([modelRegistryId])
}

model ModelVersionCapabilityAssignment {
  id                     String   @id @default(cuid())
  modelVersionId         String
  capabilityDefinitionId String
  supported              Boolean  @default(false)
  value                  Json?
  source                 String?
  confidence             Decimal? @db.Decimal(5, 4)
  verifiedAt             DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  version    ModelVersion              @relation(fields: [modelVersionId], references: [id], onDelete: Cascade)
  definition ModelCapabilityDefinition @relation(fields: [capabilityDefinitionId], references: [id], onDelete: Restrict)

  @@unique([modelVersionId, capabilityDefinitionId])
  @@index([modelVersionId])
}

model ModelCapabilityChangeLog {
  id          String   @id @default(cuid())
  entityType  String
  entityId    String
  action      String
  actorUserId String?
  before      Json?
  after       Json?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId, createdAt])
}

// ─── M5.4 Model Deprecation Management ─────────────────────────────────────────

enum ModelDeprecationStatus {
  ACTIVE
  DEPRECATION_ANNOUNCED
  DEPRECATED
  SUNSET_SCHEDULED
  RETIRED
  DISABLED
}

enum DeprecationNotificationChannel {
  IN_APP
  EMAIL
}

enum DeprecationNotificationType {
  ANNOUNCEMENT
  REMINDER_30D
  REMINDER_14D
  REMINDER_7D
  REMINDER_1D
  SUNSET_DAY
  POSTPONED
  EMERGENCY_DISABLE
}

enum DeprecationNotificationStatus {
  SCHEDULED
  SENT
  FAILED
  CANCELLED
}

model ModelDeprecationPolicy {
  id                          String                 @id @default(cuid())
  modelRegistryId             String
  modelVersionId              String?
  status                      ModelDeprecationStatus @default(ACTIVE)
  announcementDate            DateTime?
  deprecationDate             DateTime?
  sunsetDate                  DateTime?
  disabledAt                  DateTime?
  replacementModelRegistryId  String?
  replacementModelVersionId   String?
  reason                      String?
  customerMessage             String?
  internalNotes               String?
  migrationGuideUrl           String?
  source                      String?
  archived                    Boolean                @default(false)
  createdBy                   String?
  updatedBy                   String?
  createdAt                   DateTime               @default(now())
  updatedAt                   DateTime               @updatedAt

  registry            ModelRegistryEntry  @relation("DeprecationTargetModel", fields: [modelRegistryId], references: [id], onDelete: Cascade)
  version             ModelVersion?       @relation("DeprecationTargetVersion", fields: [modelVersionId], references: [id], onDelete: Cascade)
  replacementRegistry ModelRegistryEntry? @relation("DeprecationReplacementModel", fields: [replacementModelRegistryId], references: [id], onDelete: SetNull)
  replacementVersion  ModelVersion?       @relation("DeprecationReplacementVersion", fields: [replacementModelVersionId], references: [id], onDelete: SetNull)
  history             ModelDeprecationHistory[]
  notifications       ModelDeprecationNotification[]

  @@index([modelRegistryId, archived])
  @@index([modelVersionId, archived])
  @@index([status, sunsetDate])
}

model ModelDeprecationHistory {
  id              String   @id @default(cuid())
  policyId        String
  modelRegistryId String
  modelVersionId  String?
  action          String
  previousState   Json?
  newState        Json?
  reason          String?
  changedBy       String?
  createdAt       DateTime @default(now())

  policy ModelDeprecationPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId, createdAt])
  @@index([modelRegistryId, createdAt])
}

model ModelDeprecationNotification {
  id               String                        @id @default(cuid())
  policyId         String
  organizationId   String?
  userId           String?
  channel          DeprecationNotificationChannel @default(IN_APP)
  notificationType DeprecationNotificationType
  scheduledAt      DateTime
  sentAt           DateTime?
  status           DeprecationNotificationStatus  @default(SCHEDULED)
  errorMessage     String?
  createdAt        DateTime                      @default(now())
  updatedAt        DateTime                      @updatedAt

  policy ModelDeprecationPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, notificationType, channel])
  @@index([policyId, scheduledAt])
  @@index([status, scheduledAt])
}

// ─── M5.5 Model Availability Management ────────────────────────────────────────

enum ModelAvailabilityState {
  AVAILABLE
  DEGRADED
  LIMITED
  RATE_LIMITED
  MAINTENANCE
  REGION_RESTRICTED
  PROVIDER_OUTAGE
  UNAVAILABLE
  UNKNOWN
}

model ModelAvailabilityStatus {
  id                  String                 @id @default(cuid())
  modelRegistryId     String?
  modelVersionId      String?
  providerId          String?
  region              String?
  status              ModelAvailabilityState @default(UNKNOWN)
  availabilityPercent Float?
  latencyP50Ms        Int?
  latencyP95Ms        Int?
  latencyP99Ms        Int?
  errorRate           Decimal?               @db.Decimal(8, 6)
  rateLimitRemaining  Int?
  rateLimitResetAt    DateTime?
  reasonCode          String?
  reasonMessage       String?
  source              String?
  observationId       String?                @unique
  detectedAt          DateTime               @default(now())
  validUntil          DateTime?
  lastCheckedAt       DateTime               @default(now())
  isCurrent           Boolean                @default(true)
  archived            Boolean                @default(false)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  registry ModelRegistryEntry? @relation(fields: [modelRegistryId], references: [id], onDelete: Cascade)
  version  ModelVersion?       @relation(fields: [modelVersionId], references: [id], onDelete: Cascade)
  provider Provider?           @relation(fields: [providerId], references: [id], onDelete: Cascade)
  history  ModelAvailabilityHistory[]

  @@index([modelRegistryId, isCurrent, archived])
  @@index([modelVersionId, isCurrent, archived])
  @@index([providerId, region, isCurrent])
  @@index([status, validUntil])
  @@index([lastCheckedAt])
}

model ModelAvailabilityHistory {
  id                   String                  @id @default(cuid())
  availabilityStatusId String
  modelRegistryId      String?
  modelVersionId       String?
  region               String?
  previousStatus       ModelAvailabilityState?
  newStatus            ModelAvailabilityState
  previousMetrics      Json?
  newMetrics           Json?
  reason               String?
  source               String?
  changedBy            String?
  detectedAt           DateTime                @default(now())
  createdAt            DateTime                @default(now())

  availabilityStatus ModelAvailabilityStatus @relation(fields: [availabilityStatusId], references: [id], onDelete: Cascade)

  @@index([availabilityStatusId, createdAt])
  @@index([modelRegistryId, createdAt])
}

model ModelAvailabilityOverride {
  id              String                 @id @default(cuid())
  modelRegistryId String?
  modelVersionId  String?
  region          String?
  forcedStatus    ModelAvailabilityState
  reason          String?
  startsAt        DateTime               @default(now())
  endsAt          DateTime?
