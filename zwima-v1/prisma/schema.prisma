  provider                   String
  model                      String
  modelVersion               String                    @default("")
  requestedModel             String?
  resolvedModel              String?
  migrationReason            String?
  migrationPolicyId          String?
  registryEntryId            String?
  priceVersionId             String?
  costProfileId              String?
  taskType                   ComplianceTaskType        @default(CHAT)
  requestType                String                    @default("chat")
  eventSource                ComplianceEventSource     @default(API)
  environment                ComplianceEnvironmentType @default(PRODUCTION)
  inputTokens                Int                       @default(0)
  outputTokens               Int                       @default(0)
  cacheReadTokens            Int                       @default(0)
  cacheWriteTokens           Int                       @default(0)
  toolCallCount              Int                       @default(0)
  retryCount                 Int                       @default(0)
  latencyMs                  Int?
