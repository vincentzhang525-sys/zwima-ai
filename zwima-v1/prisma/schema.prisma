  @@index([organizationId, createdAt])
  @@index([workflowRunId, createdAt])
}

// ─── M11 Digital Infrastructure (additive) ───────────────────────────────────

enum InfrastructureEnvironmentType {
  DEVELOPMENT
  PREVIEW
  PRODUCTION
}

enum InfrastructureEnvironmentStatus {
  ACTIVE
  DEGRADED
  MAINTENANCE
  DISABLED
}

enum InfrastructureServiceType {
  DATABASE
  AUTH
  PROVIDER
  BILLING
  COMPLIANCE
  AGENT
  WORKFLOW
  OBSERVABILITY
  QUEUE
  CACHE
  EMAIL
  FEATURE_FLAGS
  APP
}

enum InfrastructureServiceStatus {
  ACTIVE
  DEGRADED
  DISABLED
  UNKNOWN
}

enum InfrastructureHealthStatus {
  HEALTHY
  DEGRADED
  UNHEALTHY
  UNKNOWN
}

enum DeploymentReleaseStatus {
  PENDING
  GATING
  APPROVED
  BLOCKED
  READY
  FAILED
  ROLLED_BACK
}

enum DeploymentGateStatus {
  PENDING
  PASS
  FAIL
  SKIPPED
}

enum InfrastructureIncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum InfrastructureIncidentStatus {
  OPEN
  ACKNOWLEDGED
  MITIGATING
  RESOLVED
  CLOSED
}

enum BackgroundJobStatus {
  QUEUED
  CLAIMED
  RUNNING
  COMPLETED
  FAILED
  RETRYING
  CANCELLED
  DEAD_LETTER
}

enum BackupRecordStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  EXPIRED
}

enum RestoreDrillStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  BLOCKED
  AWAITING_APPROVAL
}

enum ProviderSecretReferenceStatus {
  PRESENT
  MISSING
  INVALID_FORMAT
  ROTATION_DUE
  REVOKED
}

model InfrastructureEnvironment {
  id                    String                          @id @default(cuid())
  name                  String
  type                  InfrastructureEnvironmentType
  region                String                          @default("eu-west-1")
  status                InfrastructureEnvironmentStatus  @default(ACTIVE)
  isProduction          Boolean                         @default(false)
  configurationVersion  String                          @default("1")
  createdAt             DateTime                        @default(now())
  updatedAt             DateTime                        @updatedAt

  services              InfrastructureService[]
  healthChecks          InfrastructureHealthCheck[]
  releases              DeploymentRelease[]
  incidents             InfrastructureIncident[]
  auditEvents           InfrastructureAuditEvent[]
  backgroundJobs        BackgroundJob[]
  backups               BackupRecord[]
  restoreDrills         RestoreDrill[]
  secretReferences      ProviderSecretReference[]

  @@unique([name, type])
  @@index([type, status])
  @@index([isProduction])
}

model InfrastructureService {
  id                String                       @id @default(cuid())
  environmentId     String
  serviceType       InfrastructureServiceType
  provider          String                       @default("")
  region            String?
  endpointHash      String?
  status            InfrastructureServiceStatus  @default(UNKNOWN)
  healthStatus      InfrastructureHealthStatus   @default(UNKNOWN)
  lastHealthCheckAt DateTime?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt

  environment InfrastructureEnvironment   @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  healthChecks InfrastructureHealthCheck[]

  @@unique([environmentId, serviceType, provider])
  @@index([environmentId, healthStatus])
  @@index([serviceType, status])
}

model InfrastructureHealthCheck {
  id            String                     @id @default(cuid())
  environmentId String
  serviceId     String?
  checkType     String
  status        InfrastructureHealthStatus @default(UNKNOWN)
  latencyMs     Int?
  statusCode    Int?
  errorCode     String?
  checkedAt     DateTime                   @default(now())

  environment InfrastructureEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  service     InfrastructureService?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([environmentId, checkedAt])
  @@index([serviceId, checkedAt])
  @@index([checkType, checkedAt])
}

model DeploymentRelease {
  id                  String                  @id @default(cuid())
  environmentId       String
  deploymentId        String
  commitHash          String?
  version             String?
  status              DeploymentReleaseStatus @default(PENDING)
  initiatedBy         String?
  startedAt           DateTime                @default(now())
  completedAt         DateTime?
  rollbackOfReleaseId String?
  metadata            Json?

  environment    InfrastructureEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  rollbackOf     DeploymentRelease?        @relation("ReleaseRollback", fields: [rollbackOfReleaseId], references: [id], onDelete: SetNull)
  rollbacks      DeploymentRelease[]       @relation("ReleaseRollback")
  gateResults    DeploymentGateResult[]

  @@unique([environmentId, deploymentId])
  @@index([environmentId, startedAt])
  @@index([status, startedAt])
}

model DeploymentGateResult {
  id           String               @id @default(cuid())
  releaseId    String
  gateName     String
  status       DeploymentGateStatus @default(PENDING)
  evidencePath String?
  message      String?
  checkedAt    DateTime             @default(now())

  release DeploymentRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@unique([releaseId, gateName])
  @@index([releaseId, status])
}

model InfrastructureIncident {
  id                String                         @id @default(cuid())
  environmentId     String
  severity          InfrastructureIncidentSeverity @default(MEDIUM)
  status            InfrastructureIncidentStatus   @default(OPEN)
  title             String
  description       String?
  detectedAt        DateTime                       @default(now())
  acknowledgedAt    DateTime?
  resolvedAt        DateTime?
  ownerId           String?
  rootCause         String?
  rollbackPerformed Boolean                        @default(false)

  environment InfrastructureEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@index([environmentId, status, detectedAt])
  @@index([severity, status])
}

model InfrastructureAuditEvent {
  id                    String   @id @default(cuid())
  environmentId         String?
  action                String
  actorId               String?
  actorType             String
  targetType            String?
  targetId              String?
  result                String
  integrityHash         String
  previousIntegrityHash String?
  metadata              Json?
  createdAt             DateTime @default(now())

  environment InfrastructureEnvironment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)

  @@index([environmentId, createdAt])
  @@index([action, createdAt])
  @@index([integrityHash])
}

model BackgroundJob {
  id              String              @id @default(cuid())
  organizationId  String?
  environmentId   String
  jobType         String
  queueName       String              @default("default")
  status          BackgroundJobStatus @default(QUEUED)
  priority        Int                 @default(100)
  attempts        Int                 @default(0)
  maxAttempts     Int                 @default(3)
  scheduledAt     DateTime            @default(now())
  startedAt       DateTime?
  completedAt     DateTime?
  heartbeatAt     DateTime?
  errorCode       String?
  idempotencyKey  String
  payloadHash     String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  organization Organization?             @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  environment  InfrastructureEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@unique([environmentId, idempotencyKey])
  @@index([environmentId, status, scheduledAt])
  @@index([organizationId, status])
  @@index([jobType, status])
  @@index([queueName, status, priority])
}

model RateLimitPolicy {
  id             String   @id @default(cuid())
  organizationId String
  scope          String
  subjectType    String
  subjectId      String   @default("")
  requests       Int
  windowSeconds  Int
  burst          Int      @default(0)
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, scope, subjectType, subjectId])
  @@index([organizationId, enabled])
}

model BackupRecord {
  id                String             @id @default(cuid())
  environmentId     String
  backupType        String
  status            BackupRecordStatus @default(PENDING)
  providerReference String?
  startedAt         DateTime           @default(now())
  completedAt       DateTime?
  retentionUntil    DateTime?
  restoreTestedAt   DateTime?
  checksum          String?

  environment   InfrastructureEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  restoreDrills RestoreDrill[]

  @@index([environmentId, startedAt])
  @@index([status, startedAt])
}

model RestoreDrill {
  id                   String             @id @default(cuid())
  backupRecordId       String
  environmentId        String
  status               RestoreDrillStatus @default(PENDING)
  startedAt            DateTime           @default(now())
  completedAt          DateTime?
  recoveryPointSeconds Int?
  recoveryTimeSeconds  Int?
  resultSummary        String?
  approvedBy           String?
  approvedAt           DateTime?

  backupRecord BackupRecord              @relation(fields: [backupRecordId], references: [id], onDelete: Cascade)
  environment  InfrastructureEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@index([environmentId, startedAt])
  @@index([backupRecordId, startedAt])
  @@index([status])
}

model ServiceLevelObjective {
  id                 String   @id @default(cuid())
  organizationId     String?
  serviceType        String
  availabilityTarget Float
  latencyTargetMs    Int
  errorRateTarget    Float
  measurementWindow  String   @default("30d")
  enabled            Boolean  @default(true)
  synthetic          Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, enabled])
  @@index([serviceType, enabled])
}

model ProviderSecretReference {
  id              String                         @id @default(cuid())
  organizationId  String?
  environmentId   String
  provider        String
  secretReference String
  status          ProviderSecretReferenceStatus  @default(MISSING)
  lastValidatedAt DateTime?
  lastRotatedAt   DateTime?
  rotationDueAt   DateTime?
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt

  organization Organization?             @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  environment  InfrastructureEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@unique([environmentId, provider, secretReference])
  @@index([environmentId, status])
  @@index([organizationId, provider])
}
