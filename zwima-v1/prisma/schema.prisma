  isEuEea                Boolean     @default(false)
  isDefault              Boolean     @default(false)
  isActive               Boolean     @default(true)
  dataResidencySupported Boolean     @default(true)
  description            String?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  providerCapabilities ProviderRegionCapability[]

  @@index([regionGroup, isActive])
  @@index([isEuEea, isActive])
}

model ProviderRegionCapability {
  id                    String    @id @default(cuid())
  provider              String
  registryEntryId       String?
  regionId              String
  supportsInference     Boolean   @default(true)
  supportsProcessing    Boolean   @default(true)
  supportsDataResidency Boolean   @default(false)
  crossBorderTransfer   Boolean   @default(false)
  transferMechanism     String?
  isActive              Boolean   @default(true)
  effectiveFrom         DateTime  @default(now())
  effectiveTo           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  region ProcessingRegionRegistry @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@index([provider, regionId, isActive])
  @@index([registryEntryId, isActive])
  @@index([effectiveFrom, effectiveTo])
}

model CompliancePolicy {
  id                          String                 @id @default(cuid())
  organizationId              String?
  workspaceId                 String?
  name                        String
  version                     String
  status                      CompliancePolicyStatus @default(DRAFT)
  riskCategoryDefault         ComplianceRiskCategory @default(LIMITED)
  reviewModeDefault           HumanReviewMode        @default(OPTIONAL)
  transparencyLevelDefault    TransparencyLevel      @default(BASIC)
  requireAiNotice             Boolean                @default(true)
  requireGeneratedContentFlag Boolean                @default(true)
  requireHumanReview          Boolean                @default(false)
  requireEuProcessing         Boolean                @default(false)
  allowCrossBorderTransfer    Boolean                @default(true)
  allowedRegions              String[]               @default([])
  blockedProviders            String[]               @default([])
  blockedModels               String[]               @default([])
  retentionDays               Int                    @default(365)
  storePromptHash             Boolean                @default(true)
  storeResponseHash           Boolean                @default(true)
  storeTokenMetadata          Boolean                @default(true)
  storeCostMetadata           Boolean                @default(true)
  effectiveFrom               DateTime               @default(now())
  effectiveTo                 DateTime?
  createdBy                   String?
  createdAt                   DateTime               @default(now())
  updatedAt                   DateTime               @updatedAt

  @@unique([organizationId, workspaceId, version])
  @@index([status, effectiveFrom])
  @@index([organizationId, workspaceId, status])
}

