  code         String    @unique
  discountPct  Decimal   @db.Decimal(5, 2)
  expiresAt    DateTime?
  maxUsage     Int?
  currentUsage Int       @default(0)
  enabled      Boolean   @default(true)
  createdAt    DateTime  @default(now())
}

model Referral {
  id            String   @id @default(cuid())
  userId        String   @unique
  code          String   @unique
  commissionPct Decimal  @default(10) @db.Decimal(5, 2)
  balanceCents  Int      @default(0)
  totalEarned   Int      @default(0)
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ExchangeRate {
  id           String   @id @default(cuid())
  fromCurrency String   @default("EUR")
  toCurrency   String   @default("USD")
  rate         Decimal  @db.Decimal(12, 6)
  updatedAt    DateTime @updatedAt

  @@unique([fromCurrency, toCurrency])
}

/// M4 — immutable FX snapshots used at usage / cost confirmation time
model FxRateSnapshot {
  id            String       @id @default(cuid())
  baseCurrency  String
  quoteCurrency String       @default("EUR")
  rate          Decimal      @db.Decimal(18, 10)
  source        String
  effectiveAt   DateTime
  rateDate      DateTime
  fetchedAt     DateTime     @default(now())
  status        FxRateStatus @default(LIVE)
  isFallback    Boolean      @default(false)
  createdAt     DateTime     @default(now())

  usageLogs         UsageLog[]
  costCalculations  CostCalculation[]

  @@unique([baseCurrency, quoteCurrency, effectiveAt, source])
  @@index([baseCurrency, quoteCurrency, rateDate])
  @@index([status, fetchedAt])
}

/// M4 — FX buffer policy (provider → currency → system default)
model FxBufferPolicy {
  id                 String    @id @default(cuid())
  providerId         String?
  currency           String?
  bufferRate         Decimal   @db.Decimal(8, 6)
  minimumBufferRate  Decimal?  @db.Decimal(8, 6)
  maximumBufferRate  Decimal?  @db.Decimal(8, 6)
  lookbackDays       Int?
  volatilityBased    Boolean   @default(false)
  enabled            Boolean   @default(true)
  effectiveFrom      DateTime?
  effectiveTo        DateTime?
  label              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  provider Provider? @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, enabled])
  @@index([currency, enabled])
}

/// M4 — historical package expected-margin recalculation (does not change customer price)
model PackageMarginSnapshot {
  id                        String         @id @default(cuid())
  packageId                 String
  pricingCurrency           String         @default("EUR")
  pricingFxRate             Decimal?       @db.Decimal(18, 10)
  pricingFxUpdatedAt        DateTime?
  expectedProviderMix       Json?
  expectedCostEur           Decimal        @db.Decimal(18, 8)
  expectedBufferedCostEur   Decimal        @db.Decimal(18, 8)
  expectedGrossMarginEur    Decimal        @db.Decimal(18, 8)
  expectedGrossMarginRate   Decimal?       @db.Decimal(12, 8)
  marginStatus              FxMarginStatus @default(HEALTHY)
  revenueEur                Decimal        @db.Decimal(18, 8)
  triggerReason             String?
  createdAt                 DateTime       @default(now())

  package CreditPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId, createdAt])
  @@index([marginStatus, createdAt])
}

/// M4 — repricing review alerts (never auto-change customer prices)
model FxRepricingAlert {
  id                 String         @id @default(cuid())
  packageId          String?
  providerId         String?
  organizationId     String?
  status             FxMarginStatus
  alertCode          String
  message            String
  fxChangePct        Decimal?       @db.Decimal(12, 8)
  currentMarginRate  Decimal?       @db.Decimal(12, 8)
  pricingFxRate      Decimal?       @db.Decimal(18, 10)
  currentFxRate      Decimal?       @db.Decimal(18, 10)
  suggestedAction    String?
  acknowledged       Boolean        @default(false)
  acknowledgedAt     DateTime?
  acknowledgedBy     String?
  metadata           Json?
  createdAt          DateTime       @default(now())

  package CreditPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  @@index([status, acknowledged, createdAt])
  @@index([packageId, createdAt])
  @@index([providerId, createdAt])
}

model Notification {
