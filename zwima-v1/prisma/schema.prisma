  maximumCostPerRequest Decimal?        @db.Decimal(12, 6)
  monthlyBudgetLimit    Int?
  fallbackEnabled       Boolean         @default(true)
  maxRetries            Int               @default(2)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

