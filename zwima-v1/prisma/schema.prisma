model UsageLog {
  id             String   @id @default(cuid())
  userId         String
  apiKeyId       String?
  providerId     String
  model          String
  inputTokens    Int
  outputTokens   Int
  costCredits    Int
  providerCost   Decimal? @db.Decimal(12, 6)
  estimatedCost  Decimal? @db.Decimal(14, 6)
  actualCost     Decimal? @db.Decimal(14, 6)
  grossMargin    Decimal? @db.Decimal(14, 6)
  netMargin      Decimal? @db.Decimal(14, 6)
  marginPercent  Decimal? @db.Decimal(8, 4)
  costProfileId  String?
  priceVersionId String?
  latencyMs      Int?
  success        Boolean  @default(true)
  errorMessage   String?
  requestId      String?
  createdAt      DateTime @default(now())
  /// M4 FX — immutable snapshot tied to this usage (never overwrite with latest FX)
  providerCurrency        String?
  fxRateAtUsage           Decimal?  @db.Decimal(18, 10)
  costInProviderCurrency  Decimal?  @db.Decimal(18, 8)
  costInEur               Decimal?  @db.Decimal(18, 8)
  fxBufferRate            Decimal?  @db.Decimal(8, 6)
  fxBuffer                Decimal?  @db.Decimal(18, 8)
  bufferedCostEur         Decimal?  @db.Decimal(18, 8)
  revenueEur              Decimal?  @db.Decimal(18, 8)
  grossMarginEur          Decimal?  @db.Decimal(18, 8)
  grossMarginRate         Decimal?  @db.Decimal(12, 8)
  fxRateSource            String?
  fxRateTimestamp         DateTime?
  fxRateDate              DateTime?
  fxRatePair              String?
  fxRateStatus            FxRateStatus?
  fxRateSnapshotId        String?
  organizationId          String?
  /// Analysis-only; never mutate costInEur from revaluation
  revaluedCostInEur       Decimal?  @db.Decimal(18, 8)
  revaluedAt              DateTime?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKey   ApiKey?  @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  provider Provider @relation(fields: [providerId], references: [id])
  fxRateSnapshot FxRateSnapshot? @relation(fields: [fxRateSnapshotId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([providerId, createdAt])
  @@index([model, createdAt])
  @@index([apiKeyId, createdAt])
  @@index([requestId])
  @@index([costProfileId])
  @@index([fxRateSnapshotId])
  @@index([fxRateStatus, createdAt])
  @@index([organizationId, createdAt])
}

model CreditBalance {
