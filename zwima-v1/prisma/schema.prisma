generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  clerkId       String   @unique
  email         String   @unique
  companyName   String?
  country       String?
  vatId         String?
  tier          UserTier @default(STANDARD)
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  apiKeys              ApiKey[]
  creditBalance        CreditBalance?
  transactions         Transaction[]
  payments             Payment[]
  usageLogs            UsageLog[]
  invoices             Invoice[]
  subscriptions        Subscription[]
  referral             Referral?
  notifications        Notification[]
  auditLogs            AuditLog[]
  ownedOrganizations   Organization[]       @relation("OrgOwner")
  organizationMembers  OrganizationMember[]
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   User                 @relation("OrgOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members OrganizationMember[]
  apiKeys ApiKey[]

  @@index([ownerId])
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           OrgRole  @default(DEVELOPER)
  invitedEmail   String?
  accepted       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model ApiKey {
  id             String        @id @default(cuid())
  userId         String
  organizationId String?
  name           String
  keyHash        String
  prefix         String
  enabled        Boolean       @default(true)
  permission     KeyPermission @default(FULL)
  ipWhitelist    String?
  usageLimit     Int?
  usageCount     Int           @default(0)
  expiresAt      DateTime?
  createdAt      DateTime      @default(now())
  lastUsed       DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  usageLogs    UsageLog[]

  @@index([userId])
  @@index([keyHash])
  @@index([organizationId])
}

model Provider {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  enabled      Boolean  @default(true)
  weight       Int      @default(100)
  priority     Int      @default(0)
  config       Json?
  lastError    String?
  lastLatency  Int?
  lastHealthAt DateTime?
  createdAt    DateTime @default(now())

  usageLogs UsageLog[]
}

model ModelPricing {
  id               String   @id @default(cuid())
  providerSlug     String
  modelId          String
  inputTokenCost   Decimal  @db.Decimal(12, 6)
  outputTokenCost  Decimal  @db.Decimal(12, 6)
  marginPercent    Decimal  @default(30) @db.Decimal(6, 2)
  customerPriceIn  Decimal  @db.Decimal(12, 6)
  customerPriceOut Decimal  @db.Decimal(12, 6)
  updatedAt        DateTime @updatedAt

  @@unique([providerSlug, modelId])
  @@index([providerSlug])
}

model MarginRule {
  id         String      @id @default(cuid())
  scope      MarginScope
  targetId   String?
  multiplier Decimal     @default(1.3) @db.Decimal(6, 3)
  label      String?
  enabled    Boolean     @default(true)
  updatedAt  DateTime    @updatedAt

  @@index([scope, targetId])
}

model CreditPackage {
  id        String   @id @default(cuid())
  label     String
  amountEur Decimal  @db.Decimal(10, 2)
  credits   Int
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model Transaction {
  id          String          @id @default(cuid())
  userId      String
  type        TransactionType
  amount      Int
  amountEur   Decimal?        @db.Decimal(10, 2)
  description String?
  metadata    Json?
  invoiceId   String?
  createdAt   DateTime        @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model Payment {
  id              String        @id @default(cuid())
  userId          String
  stripeSessionId String?       @unique
  stripePaymentId String?
  packageId       String?
  couponCode      String?
  amountEur       Decimal       @db.Decimal(10, 2)
  credits         Int
  status          PaymentStatus @default(PENDING)
  invoiceId       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model Invoice {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique
  userId        String
  companyName   String?
  country       String?
  vatId         String?
  subtotalEur   Decimal  @db.Decimal(10, 2)
  taxEur        Decimal  @db.Decimal(10, 2)
  totalEur      Decimal  @db.Decimal(10, 2)
  paid          Boolean  @default(false)
  lineItems     Json?
  createdAt     DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments     Payment[]
  transactions Transaction[]

  @@index([userId, createdAt])
}

model UsageLog {
  id           String   @id @default(cuid())
  userId       String
  apiKeyId     String?
  providerId   String
  model        String
  inputTokens  Int
  outputTokens Int
  costCredits  Int
  providerCost Decimal? @db.Decimal(12, 6)
  latencyMs    Int?
  success      Boolean  @default(true)
  errorMessage String?
  createdAt    DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKey   ApiKey?  @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  provider Provider @relation(fields: [providerId], references: [id])

  @@index([userId, createdAt])
  @@index([providerId, createdAt])
  @@index([model, createdAt])
  @@index([apiKeyId, createdAt])
}

model CreditBalance {
  id               String   @id @default(cuid())
  userId           String   @unique
  credits          Int      @default(0)
  frozenCredits    Int      @default(0)
  lifetimeSpend    Int      @default(0)
  lifetimeRecharge Int      @default(0)
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String
  plan                 SubscriptionPlan
  stripeSubscriptionId String?            @unique
  stripeCustomerId     String?
  status               SubscriptionStatus @default(ACTIVE)
  amountEur            Decimal?           @db.Decimal(10, 2)
  creditsPerPeriod     Int?
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Coupon {
  id           String    @id @default(cuid())
  code         String    @unique
  discountPct  Decimal   @db.Decimal(5, 2)
  expiresAt    DateTime?
  maxUsage     Int?
  currentUsage Int       @default(0)
  enabled      Boolean   @default(true)
  createdAt    DateTime  @default(now())
}

model Referral {
  id            String   @id @default(cuid())
  userId        String   @unique
  code          String   @unique
  commissionPct Decimal  @default(10) @db.Decimal(5, 2)
  balanceCents  Int      @default(0)
  totalEarned   Int      @default(0)
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ExchangeRate {
  id           String   @id @default(cuid())
  fromCurrency String   @default("EUR")
  toCurrency   String   @default("USD")
  rate         Decimal  @db.Decimal(12, 6)
  updatedAt    DateTime @updatedAt

  @@unique([fromCurrency, toCurrency])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
}

model AuditLog {
  id        String        @id @default(cuid())
  userId    String?
  action    String
  category  AuditCategory
  detail    Json?
  ip        String?
  createdAt DateTime      @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([category, createdAt])
}

enum OrgRole {
  OWNER
  ADMIN
  BILLING
  DEVELOPER
  VIEWER
}

enum KeyPermission {
  FULL
  READ
  CHAT
}

enum NotificationType {
  LOW_BALANCE
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  API_ERROR
  PROVIDER_DOWN
  NEW_INVOICE
  TEAM_INVITE
}

enum AuditCategory {
  LOGIN
  API_KEY
  BILLING
  RECHARGE
  PROVIDER
  ADMIN
  TEAM
}

enum UserTier {
  STANDARD
  VIP
  ENTERPRISE
}

enum MarginScope {
  GLOBAL
  PROVIDER
  MODEL
  ENTERPRISE
  VIP
  CUSTOM
}

enum TransactionType {
  RECHARGE
  USAGE
  REFUND
  ADJUSTMENT
  TRANSFER
  EXPIRATION
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum SubscriptionPlan {
  MONTHLY
  YEARLY
  USAGE_BASED
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  PAUSED
}
