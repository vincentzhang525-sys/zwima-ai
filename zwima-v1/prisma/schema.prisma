  APPROVED
  REJECTED
  CANCELLED
}

model WorkflowDefinition {
  id               String                  @id @default(cuid())
  workflowId       String                  @unique
  organizationId   String
  workspaceId      String?
  name             String
  description      String?
  status           WorkflowLifecycleStatus @default(DRAFT)
  currentVersionId String?
  createdBy        String
  updatedBy        String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  versions     WorkflowVersion[]
  triggers     WorkflowTrigger[]
  executions   WorkflowExecution[]
  secrets      WorkflowSecretReference[]

  @@index([organizationId, status, createdAt])
  @@index([organizationId, workspaceId])
  @@index([createdBy])
}

model WorkflowVersion {
  id              String                  @id @default(cuid())
  versionId       String                  @unique
  workflowId      String
  versionNumber   Int
  status          WorkflowLifecycleStatus @default(DRAFT)
  graphChecksum   String?
  createdBy       String
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  publishedAt     DateTime?

  workflow      WorkflowDefinition      @relation(fields: [workflowId], references: [workflowId], onDelete: Cascade)
  nodes         WorkflowNode[]
  edges         WorkflowEdge[]
  variables     WorkflowVariable[]
  retryPolicy   WorkflowRetryPolicy?
  errorPolicy   WorkflowErrorPolicy?
  executions    WorkflowExecution[]

  @@unique([workflowId, versionNumber])
  @@index([workflowId, status])
}

model WorkflowNode {
  id              String           @id @default(cuid())
  nodeId          String           @unique
  versionId       String
  key             String
