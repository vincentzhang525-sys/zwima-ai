// ─── M7 Enterprise Management Console (additive) ─────────────────────────────

model EnterpriseOrgProfile {
  id               String   @id @default(cuid())
  organizationId   String   @unique
  legalName        String?
  displayName      String?
  industry         String?
  website          String?
  country          String?
  addressLine1     String?
  addressLine2     String?
  city             String?
  postalCode       String?
  taxId            String?
  billingEmail     String?
  supportEmail     String?
  businessSettings Json?
  createdBy        String?
  updatedBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
}

model EnterpriseWorkspace {
  id             String   @id @default(cuid())
  organizationId String
  workspaceKey   String
  name           String
  description    String?
  status         EnterpriseRecordStatus @default(ACTIVE)
  settings       Json?
  isDefault      Boolean  @default(false)
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invitations  EnterpriseInvitation[]
  memberRoles  EnterpriseMemberRole[]
  apiAccesses  EnterpriseApiAccess[]

  @@unique([organizationId, workspaceKey])
  @@index([organizationId, status])
}

model EnterpriseDepartment {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  description    String?
  parentId       String?
  status         EnterpriseRecordStatus @default(ACTIVE)
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  teams        EnterpriseTeam[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
}

model EnterpriseTeam {
  id             String   @id @default(cuid())
  organizationId String
  departmentId   String?
  code           String
  name           String
  description    String?
  status         EnterpriseRecordStatus @default(ACTIVE)
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  department   EnterpriseDepartment? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  members      EnterpriseTeamMember[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([departmentId])
}

model EnterpriseTeamMember {
  id             String   @id @default(cuid())
  teamId         String
  organizationId String
  userId         String
  title          String?
  status         EnterpriseRecordStatus @default(ACTIVE)
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  team EnterpriseTeam @relation(fields: [teamId], references: [id], onDelete: Restrict)

  @@unique([teamId, userId])
  @@index([organizationId, userId])
}

model EnterpriseInvitation {
  id             String   @id @default(cuid())
  organizationId String
  workspaceId    String?
  email          String
  roleCode       String   @default("MEMBER")
  tokenHash      String
  status         EnterpriseInvitationStatus @default(PENDING)
  invitedBy      String?
  acceptedAt     DateTime?
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workspace    EnterpriseWorkspace? @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@index([email, status])
  @@unique([organizationId, email, status])
}

model EnterpriseRole {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  description    String?
  permissions    String[] @default([])
  isSystem       Boolean  @default(false)
  isCustom       Boolean  @default(true)
  status         EnterpriseRecordStatus @default(ACTIVE)
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assignments  EnterpriseMemberRole[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
}

model EnterpriseMemberRole {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  roleId         String
  workspaceId    String?
  status         EnterpriseRecordStatus @default(ACTIVE)
  assignedBy     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  role         EnterpriseRole       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  workspace    EnterpriseWorkspace? @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId, roleId])
  @@index([organizationId, userId])
  @@index([roleId])
}

model EnterpriseApiAccess {
  id               String   @id @default(cuid())
  organizationId   String
  workspaceId      String?
  apiKeyId         String?
  name             String
  status           EnterpriseRecordStatus @default(ACTIVE)
  dailyQuota       Int?
  monthlyQuota     Int?
  rpmLimit         Int?
  usageLimit       Int?
  currentDailyUsage Int     @default(0)
  currentMonthlyUsage Int   @default(0)
  metadata         Json?
  createdBy        String?
  updatedBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workspace    EnterpriseWorkspace? @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@index([apiKeyId])
}

model EnterpriseCostCenter {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  description    String?
  budgetEur      Decimal  @default(0) @db.Decimal(18, 6)
  spentEur       Decimal  @default(0) @db.Decimal(18, 6)
