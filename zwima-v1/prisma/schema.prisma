  organizationId String
  workflowRunId  String
  previousStatus String?
  newStatus      String
  action         String
  actorType      String
  actorId        String?
  reason         String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
