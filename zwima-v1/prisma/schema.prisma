// ─── V1.1 Frozen Architecture Enhancement (additive) ─────────────────────────

model TaskCostProfile {
  id                       String   @id @default(cuid())
  organizationId           String
  workspaceId              String?
  name                     String
  taskType                 String
  inputTemplateHash        String?
  expectedOutputType       String?
  averageInputTokens       Int
  averageOutputTokens      Int
  averageCachedInputTokens Int?
  averageToolCalls         Int?
  averageLatencyMs         Int?
  sampleCount              Int      @default(0)
  currency                 String   @default("EUR")
  active                   Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  snapshots    ModelEffectiveCostSnapshot[]

  @@index([organizationId, active])
  @@index([organizationId, taskType])
}

model ModelEffectiveCostSnapshot {
  id                    String   @id @default(cuid())
  organizationId        String?
  providerId            String?
  registryEntryId       String?
  modelVersion          String?
  tokenizerVersion      String?
  taskCostProfileId     String?
  standardInputPrice    Decimal  @db.Decimal(14, 6)
  standardOutputPrice   Decimal  @db.Decimal(14, 6)
  cachedInputPrice      Decimal? @db.Decimal(14, 6)
  cacheWritePrice       Decimal? @db.Decimal(14, 6)
  batchInputPrice       Decimal? @db.Decimal(14, 6)
  batchOutputPrice      Decimal? @db.Decimal(14, 6)
  promotionInputPrice   Decimal? @db.Decimal(14, 6)
  promotionOutputPrice  Decimal? @db.Decimal(14, 6)
  promotionStartDate    DateTime?
  promotionEndDate      DateTime?
  estimatedInputTokens  Int
  estimatedOutputTokens Int
  effectiveInputCost    Decimal  @db.Decimal(14, 6)
  effectiveOutputCost   Decimal  @db.Decimal(14, 6)
  effectiveCacheCost    Decimal  @db.Decimal(14, 6) @default(0)
  effectiveToolCost     Decimal? @db.Decimal(14, 6)
  effectiveTotalCost    Decimal  @db.Decimal(14, 6)
  currency              String   @default("EUR")
  calculatedAt          DateTime @default(now())
  calculationVersion    String   @default("v1.1")
  source                String   @default("synthetic_preview")
  metadata              Json?

  organization    Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  taskCostProfile TaskCostProfile? @relation(fields: [taskCostProfileId], references: [id], onDelete: SetNull)

  @@index([organizationId, calculatedAt])
  @@index([registryEntryId, calculatedAt])
  @@index([taskCostProfileId])
}

model EnterpriseAIModelScore {
  id                 String   @id @default(cuid())
  organizationId     String
  provider           String
  registryEntryId    String?
  costScore          Decimal  @db.Decimal(8, 4)
  latencyScore       Decimal  @db.Decimal(8, 4)
  qualityScore       Decimal  @db.Decimal(8, 4)
  availabilityScore  Decimal  @db.Decimal(8, 4)
  complianceScore    Decimal  @db.Decimal(8, 4)
  lifecycleScore     Decimal  @db.Decimal(8, 4)
  concentrationScore Decimal  @db.Decimal(8, 4)
  overallScore       Decimal  @db.Decimal(8, 4)
  calculationVersion String   @default("v1.1")
  calculatedAt       DateTime @default(now())
  evidence           Json?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, calculatedAt])
  @@index([organizationId, provider])
}

enum AgentToolExecutionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  BLOCKED
  ROLLED_BACK
}

model AgentToolExecution {
