// =============================================================================
// M8 Agent Platform (additive — Mock provider only; no M1–M7 field semantics changed)
// =============================================================================

enum AgentLifecycleStatus {
  DRAFT
  ACTIVE
  PAUSED
  DEPRECATED
  ARCHIVED
}

enum AgentRunStatus {
  QUEUED
  RUNNING
  WAITING_TOOL
  WAITING_REVIEW
  COMPLETED
  FAILED
  CANCELLED
  TIMED_OUT
}

enum ToolRuntimeStatus {
  ENABLED
  DISABLED
}

enum PromptLifecycleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AgentMemoryScope {
  CONVERSATION
  RUN
  WORKSPACE
}

/// M8 Phase 2A — richer memory classification, additive alongside the Phase 1
/// `AgentMemoryScope`. Stored on `AgentMemory.memoryType` (nullable, so Phase 1
/// rows created before this migration remain valid with `memoryType = null`).
enum AgentMemoryType {
  USER
  WORKSPACE
  EXECUTION_SUMMARY
}

enum AgentStepType {
  PLAN
  MODEL
  TOOL
  REVIEW
  DELEGATE
  SYSTEM
}

enum AgentRunStepStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

enum ToolExecutionStatus {
  SUCCESS
  FAILED
}

enum AgentReviewLinkStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  WAIVED
}

model AgentDefinition {
  id               String               @id @default(cuid())
  agentId          String               @unique
  organizationId   String
  workspaceId      String?
  name             String
  description      String?
  status           AgentLifecycleStatus @default(DRAFT)
  currentVersionId String?
  createdBy        String
  updatedBy        String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  versions     AgentVersion[]
  runs         AgentRun[]
  memories     AgentMemory[]

  @@index([organizationId, status, createdAt])
  @@index([organizationId, workspaceId])
  @@index([createdBy])
}

model AgentVersion {
  id                    String               @id @default(cuid())
  versionId             String               @unique
  agentId               String
  versionNumber         Int
  status                AgentLifecycleStatus @default(DRAFT)
  systemPrompt          String
  promptTemplateId      String?
  promptVersionId       String?
  provider              String               @default("mock")
  model                 String
  temperature           Float                @default(0.7)
  maxTokens             Int                  @default(1024)
  toolIds               String[]             @default([])
  memoryScope           AgentMemoryScope     @default(CONVERSATION)
  maxDelegationDepth    Int                  @default(2)
  maxDelegationChildren Int                  @default(3)
  reviewRequired        Boolean              @default(false)
  config                Json                 @default("{}")
  createdBy             String
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  publishedAt           DateTime?

  agent AgentDefinition @relation(fields: [agentId], references: [agentId], onDelete: Cascade)
  runs  AgentRun[]

  @@unique([agentId, versionNumber])
  @@index([agentId, status])
  @@index([promptTemplateId])
}

model AgentRun {
  id                      String         @id @default(cuid())
  runId                   String         @unique
  agentId                 String
  agentVersionId          String
  organizationId          String
  workspaceId             String?
  userId                  String?
  status                  AgentRunStatus @default(QUEUED)
  input                   Json
  output                  Json?
  idempotencyKey          String?
  parentRunId             String?
  rootRunId               String?
  depth                   Int            @default(0)
  costEstimate            Float?
  costActual              Float?
  grossMargin             Float?
  priceVersionId          String?
  costCalculationId       String?
  requestedModel          String?
  resolvedModel           String?
  modelVersion            String?
  migrationReason         String?
  tokenUsage              Json           @default("{\"inputTokens\":0,\"outputTokens\":0}")
  latencyMs               Int?
  errorMessage            String?
  errorClass              String?
  eventId                 String?
  reviewCaseId            String?
  retryOfRunId            String?
  processingRegion        String?
  compliancePolicyVersion String?
  executionVersion        String?
  policyVersion           String?
  runtimeDriftStatus      String?
  approvalStatus          String?
  rollbackStatus          String?
  complianceEventId       String?
  estimatedCostAmount     Decimal?       @db.Decimal(14, 6)
  actualCostAmount        Decimal?       @db.Decimal(14, 6)
  startedAt               DateTime?
  completedAt             DateTime?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  agent          AgentDefinition   @relation(fields: [agentId], references: [agentId], onDelete: Restrict)
  version        AgentVersion      @relation(fields: [agentVersionId], references: [versionId], onDelete: Restrict)
  steps          AgentRunStep[]
  toolExecutions ToolExecution[]
  reviewLinks    AgentReviewLink[]
  parentDelegations AgentDelegation[] @relation("DelegationParent")
  childDelegations  AgentDelegation[] @relation("DelegationChild")
  toolGovernanceRecords AgentToolExecution[]
  resourceAccessRecords AgentResourceAccess[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, agentId, createdAt])
  @@index([parentRunId])
  @@index([rootRunId])
  @@index([eventId])
  @@index([reviewCaseId])
  @@index([userId, createdAt])
}

model AgentRunStep {
  id              String             @id @default(cuid())
  stepId          String             @unique
  runId           String
  stepType        AgentStepType
  sequence        Int
  status          AgentRunStepStatus @default(PENDING)
  input           Json?
  output          Json?
  toolExecutionId String?
  errorMessage    String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime           @default(now())

  run AgentRun @relation(fields: [runId], references: [runId], onDelete: Cascade)

  @@unique([runId, sequence])
  @@index([runId, stepType])
}

model ToolDefinition {
  id               String            @id @default(cuid())
  toolId           String            @unique
  organizationId   String?
  key              String
  name             String
  description      String?
  status           ToolRuntimeStatus @default(ENABLED)
  currentVersionId String?
  isMock           Boolean           @default(true)
  createdBy        String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  organization Organization?  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  versions     ToolVersion[]
  executions   ToolExecution[]

  @@unique([organizationId, key])
  @@index([status])
  @@index([isMock])
}

model ToolVersion {
  id              String            @id @default(cuid())
  versionId       String            @unique
  toolId          String
  versionNumber   Int
  inputSchema     Json              @default("{}")
  outputSchema    Json              @default("{}")
  handlerKey      String
  timeoutMs       Int               @default(10000)
  maxRetries      Int               @default(0)
  permissionScope String            @default("org")
  status          ToolRuntimeStatus @default(ENABLED)
  createdAt       DateTime          @default(now())

  tool       ToolDefinition  @relation(fields: [toolId], references: [toolId], onDelete: Cascade)
  executions ToolExecution[]

  @@unique([toolId, versionNumber])
  @@index([toolId, status])
}

model ToolExecution {
  id             String              @id @default(cuid())
  executionId    String              @unique
  runId          String
  stepId         String?
  toolId         String
  toolVersionId  String
  organizationId String
  input          Json
  output         Json?
  status         ToolExecutionStatus
  errorMessage   String?
  latencyMs      Int?
  createdAt      DateTime            @default(now())

  run         AgentRun       @relation(fields: [runId], references: [runId], onDelete: Cascade)
  tool        ToolDefinition @relation(fields: [toolId], references: [toolId], onDelete: Restrict)
  toolVersion ToolVersion    @relation(fields: [toolVersionId], references: [versionId], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([runId, createdAt])
  @@index([toolId, createdAt])
}

model PromptTemplate {
  id               String                @id @default(cuid())
  templateId       String                @unique
  organizationId   String
  workspaceId      String?
  key              String
  name             String
  description      String?
  status           PromptLifecycleStatus @default(DRAFT)
  currentVersionId String?
  createdBy        String
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  versions     PromptVersion[]
  testCases    PromptTestCase[]

  @@unique([organizationId, key])
  @@index([organizationId, status])
  @@index([organizationId, workspaceId])
}

model PromptVersion {
  id            String                @id @default(cuid())
  versionId     String                @unique
  templateId    String
  versionNumber Int
  content       String
  variables     String[]              @default([])
  status        PromptLifecycleStatus @default(DRAFT)
  createdBy     String
  createdAt     DateTime              @default(now())
  publishedAt   DateTime?

  template PromptTemplate @relation(fields: [templateId], references: [templateId], onDelete: Cascade)

  @@unique([templateId, versionNumber])
  @@index([templateId, status])
}

model PromptTestCase {
  id               String   @id @default(cuid())
  testCaseId       String   @unique
  templateId       String
  name             String
  variables        Json     @default("{}")
  expectedContains String?
  createdBy        String?
  createdAt        DateTime @default(now())

  template PromptTemplate @relation(fields: [templateId], references: [templateId], onDelete: Cascade)

  @@index([templateId, createdAt])
}

model AgentMemory {
  id             String           @id @default(cuid())
  memoryId       String           @unique
  organizationId String
  workspaceId    String?
  agentId        String
  runId          String?
  scope          AgentMemoryScope
  key            String
  valueHash      String
  valuePreview   String
  metadata       Json?
  expiresAt      DateTime?
  createdBy      String
  createdAt      DateTime         @default(now())

  /// --- M8 Phase 2A additive fields (all nullable; existing Phase 1 rows are unaffected) ---
  /// Set when this entry is scoped to a specific member (memoryType = USER).
  userId     String?
  /// Richer Phase 2A classification alongside the Phase 1 `scope` field.
  memoryType AgentMemoryType?
  /// Phase 2A bounded plaintext content (still secret-scanned before write and
  /// length-capped by `AgentMemoryPolicy.maxEntryCharacters`). `valueHash` /
  /// `valuePreview` above remain the required Phase 1 fields and are always
  /// populated too, so this column is purely additive.
  value      String?
  updatedAt  DateTime         @default(now()) @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  agent        AgentDefinition @relation(fields: [agentId], references: [agentId], onDelete: Cascade)

  @@index([organizationId, agentId, scope])
  @@index([organizationId, workspaceId])
  @@index([organizationId, agentId, memoryType])
  @@index([runId])
  @@index([expiresAt])
}

/// M8 Agent Platform Phase 2A — reusable agent templates.
///
/// `organizationId = null` marks a system (built-in) template; the actual
/// content for the three Phase 2A system templates is defined in code
/// (`src/core/agents/template-catalog.ts`), not seeded into this table. A
/// `null`-organization row here only ever represents a platform-admin
/// *override* of a system template's fields, or an additional admin-created
/// system template — never a required seed row. Workspace/customer templates
/// always carry a non-null `organizationId`.
model AgentTemplate {
  id                 String   @id @default(cuid())
  templateId         String   @unique
  organizationId     String?
  workspaceId        String?
  name               String
  slug               String
  description        String?
  category           String
  systemPrompt       String
  defaultModel       String
  defaultTemperature Float
  defaultMaxSteps    Int
  defaultTimeoutMs   Int
  defaultCostCeiling Float
  allowedToolKeys    String[] @default([])
  isSystemTemplate   Boolean  @default(false)
  isActive           Boolean  @default(true)
  createdBy          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, slug])
  @@index([organizationId, category])
  @@index([isSystemTemplate, isActive])
}

/// M8 Agent Platform Phase 2A — per-agent memory policy. Defaults to memory
/// fully disabled; creating this row (or leaving it absent) never
/// automatically enables memory for a run — see `memory-policy-service.ts`.
model AgentMemoryPolicy {
  id                   String   @id @default(cuid())
  policyId             String   @unique
  organizationId       String
  workspaceId          String?
  /// String reference to `AgentDefinition.agentId` (not a hard Prisma
  /// relation, matching the existing `AgentReviewLink`/`AgentDelegation`
  /// string-ref convention) — one policy row per agent.
  agentId              String   @unique
  memoryEnabled        Boolean  @default(false)
  allowUserMemory      Boolean  @default(false)
  allowWorkspaceMemory Boolean  @default(false)
  maxEntries           Int      @default(50)
  maxEntryCharacters   Int      @default(2000)
  retentionDays        Int      @default(30)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
}

/// Links an AgentRun to an existing M6 HumanReviewCase / AIEvent (string refs — no frozen-table FK).
model AgentReviewLink {
  id             String                @id @default(cuid())
  linkId         String                @unique
  runId          String
  stepId         String?
  eventId        String
  reviewCaseId   String
  organizationId String
  status         AgentReviewLinkStatus @default(PENDING)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  run AgentRun @relation(fields: [runId], references: [runId], onDelete: Cascade)

  @@index([organizationId, status, createdAt])
  @@index([runId])
  @@index([reviewCaseId])
  @@index([eventId])
}

model AgentDelegation {
  id             String   @id @default(cuid())
  delegationId   String   @unique
  parentRunId    String
  childRunId     String
  parentAgentId  String
  childAgentId   String
  organizationId String
  depth          Int
  createdAt      DateTime @default(now())

  parentRun AgentRun @relation("DelegationParent", fields: [parentRunId], references: [runId], onDelete: Cascade)
  childRun  AgentRun @relation("DelegationChild", fields: [childRunId], references: [runId], onDelete: Cascade)

  @@unique([parentRunId, childRunId])
  @@index([organizationId, createdAt])
  @@index([parentAgentId])
  @@index([childAgentId])
}

/// Org-level agent platform policies (timeouts, budgets, forced-review tools, etc.).
model AgentOrgPolicy {
  id             String   @id @default(cuid())
  policyId       String   @unique
  organizationId String
  key            String
  value          Json
  version        Int      @default(1)
  updatedBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, key])
  @@index([organizationId])
}

// ─── M8 Agent Platform Phase 1 additions (additive only) ────────────────────

/// Binds a tool (by key, and optionally a specific ToolDefinition) to an agent
/// (or a specific agent version) within an organization. Used by the Phase 1
/// `src/core/agents` facade to decide which tools an agent run may invoke,
/// independent of the looser `AgentVersion.toolIds` string array.
model AgentToolBinding {
  id             String   @id @default(cuid())
  bindingId      String   @unique @default(cuid())
  organizationId String
  agentId        String
  agentVersionId String?
  toolId         String?
  key            String
  enabled        Boolean  @default(true)
  createdBy      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([agentId, key, agentVersionId])
  @@index([organizationId, agentId, enabled])
  @@index([toolId])
}

/// Append-only audit trail for the Phase 1 agent facade (create/run/cancel/
/// safety-block events). System prompts and other sensitive content must be
/// redacted (hashed/previewed) by the caller before being written here —
/// this table itself has no redaction logic.
model AgentExecutionLog {
  id             String   @id @default(cuid())
  logId          String   @unique @default(cuid())
  organizationId String
  workspaceId    String?
  agentId        String?
  runId          String?
  level          String
  event          String
  message        String
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([organizationId, agentId, createdAt])
  @@index([runId])
  @@index([event])
}

// ─── M9 Workflow Automation (additive; Mock execution only) ─────────────────

enum WorkflowLifecycleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum WorkflowTriggerType {
  MANUAL
  SCHEDULED
  API
  WEBHOOK
  EVENT
  AGENT
  APPROVAL
}

enum WorkflowNodeType {
  START
  END
  AGENT
  MODEL
  HTTP_REQUEST
  CONDITION
  TRANSFORM
  DELAY
  APPROVAL
  NOTIFICATION
  DATA_INPUT
  DATA_OUTPUT
  PARALLEL
  MERGE
  SUB_WORKFLOW
}

enum WorkflowExecutionStatus {
  QUEUED
  RUNNING
  PAUSED
  WAITING_APPROVAL
  RETRYING
  COMPLETED
  FAILED
  CANCELLED
  TIMED_OUT
  ROLLING_BACK
  ROLLED_BACK
}

enum WorkflowStepStatus {
